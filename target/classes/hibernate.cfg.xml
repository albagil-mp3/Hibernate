<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
    "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
    "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">

<hibernate-configuration>
    <session-factory>
        <!-- Database connection settings -->
        <property name="hibernate.connection.driver_class">com.mysql.cj.jdbc.Driver</property>
        <property name="hibernate.connection.url">jdbc:mysql://localhost:3306/facturacio?useSSL=false&amp;serverTimezone=UTC&amp;allowPublicKeyRetrieval=true</property>
        <property name="hibernate.connection.username">usuario</property>
        <property name="hibernate.connection.password">1234</property>
        
        <!-- JDBC connection pool settings -->
        <property name="hibernate.connection.pool_size">1</property>
        
        <!-- SQL dialect -->
        <property name="hibernate.dialect">org.hibernate.dialect.MySQL8Dialect</property>
        
        <!-- Echo all executed SQL to stdout -->
        <property name="hibernate.show_sql">true</property>
        <property name="hibernate.format_sql">true</property>
        
        <!-- Drop and re-create the database schema on startup -->
        <property name="hibernate.hbm2ddl.auto">update</property>
        
        <!-- Disable bean validation to avoid javax/jakarta conflicts -->
        <property name="javax.persistence.validation.mode">none</property>
        
        <!-- Names the annotated entity classes -->
        <mapping class="com.billing.entity.Client"/>
        <mapping class="com.billing.entity.Article"/>
        <mapping class="com.billing.entity.Supplier"/>
        <mapping class="com.billing.entity.ArticleFamily"/>
        <mapping class="com.billing.entity.ArticleCategory"/>
        <mapping class="com.billing.entity.Unit"/>
        
    </session-factory>
</hibernate-configuration>